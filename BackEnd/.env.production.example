# Backend Production Environment Configuration
# Copy this file to .env.production and fill in your production values
# DO NOT commit .env.production - it should contain real secrets

# PostgreSQL Database
POSTGRES_HOST=your_production_database_host
POSTGRES_PORT=5432
POSTGRES_DB=assurclair
POSTGRES_USER=your_production_db_user
POSTGRES_PASSWORD=your_production_db_password

# API Keys
GEMINI_API_KEY=your_production_gemini_api_key

# JWT Secret (generate a strong random string)
JWT_SECRET=your_production_jwt_secret_change_me

# Server Configuration
PORT=4000
FRONTEND_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
