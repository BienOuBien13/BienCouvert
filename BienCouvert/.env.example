# ============================================================
# Variables d'environnement BienCouvert (Expo)
# Copier ce fichier en .env.local et remplir les valeurs
# Les variables EXPO_PUBLIC_* sont exposées côté client
# ============================================================

# URL de l'API backend AssurClair
EXPO_PUBLIC_API_URL=http://localhost:3000

# Activer les logs de debug (true/false)
EXPO_PUBLIC_DEBUG=false
