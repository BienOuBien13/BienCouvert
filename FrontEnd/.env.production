# Variables d'environnement Frontend pour PRODUCTION (Docker sur VM)
# Ce fichier sera utilisé par Vite lors du build de production

# URL du backend via le proxy nginx
# Le code ajoute automatiquement /api, donc on met juste la racine
VITE_API_URL=
VITE_API_BASE_URL=

# Note: La clé Gemini est UNIQUEMENT côté backend pour la sécurité
# Le frontend appelle le backend qui fait les requêtes vers Gemini
