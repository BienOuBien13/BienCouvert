# Configuration pour docker-compose
# Copier ce fichier en .env et remplir les valeurs

# JWT Secret (générer une clé aléatoire forte)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Clé API Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
POSTGRES_HOST=your_database_host
POSTGRES_PORT=5432
POSTGRES_DB=assurclair
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Frontend Origin (comma-separated list of allowed origins)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080
